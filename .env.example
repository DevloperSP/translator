# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# OpenAI API Key (for Speech-to-Text & Translation)
OPENAI_API_KEY=sk-replace-with-your-openai-key

# Replicate API Token (for pay-per-use XTTS-v2 Same-Voice Cloning)
REPLICATE_API_TOKEN=r8_replace-with-your-replicate-token

# Optional OpenAI model overrides
OPENAI_STT_MODEL=whisper-1
OPENAI_TRANSLATE_MODEL=gpt-4o-mini

# Optional Replicate XTTS-v2 overrides
REPLICATE_XTTS_MODEL=lucataco/xtts-v2:684bc3855b37866c0c65add2ff39c78f3dea3f4ff103a436465326e0f438d55e
XTTS_CLEANUP_VOICE=true

# Optional Audio / UX limits
MAX_AUDIO_FILE_MB=20
SPEAKER_REF_MAX_SECONDS=15
MAX_TTS_CHUNK_CHARS=240

# Optional Webhook mode for Heroku web dyno (leave empty for worker polling mode)
WEBHOOK_URL=
WEBHOOK_SECRET_TOKEN=
PORT=8080
LOG_LEVEL=INFO
